# Tenderly API access — the only values you provide. Everything else (VNets,
# RPC URLs, random user/validator keys) is generated by `npm run setup`.
TENDERLY_API_TOKEN=
TENDERLY_ACCOUNT_ID=
TENDERLY_PROJECT=

# Optional: fork a fixed block instead of the latest (reproducible runs).
# TENDERLY_FORK_BLOCK_ETH=
# TENDERLY_FORK_BLOCK_GC=

# Optional: oracle image the compose files run (default gnosischain/tokenbridge).
# Must be a real env var in your shell for docker compose, not just in this file.
# ORACLE_IMAGE=
