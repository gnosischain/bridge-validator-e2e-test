# ── RPCs (required) ──────────────────────────────────────────────────────────
# Needs eth_getLogs over a few thousand blocks per tick — use a paid endpoint,
# public ones reject the range.
ETH_RPC=
GC_RPC=

# ── Contract K, one per validator implementation, both on Gnosis Chain ───────
# Format: name:0xAddress,name:0xAddress
VALIDATORS=nodejs:0x0000000000000000000000000000000000000000,rust:0x0000000000000000000000000000000000000000

# ── Validation rules ─────────────────────────────────────────────────────────
# Max seconds between the source event and the contract K receipt.
# eth->gc: 1-2 ETH blocks. gc->eth: GC finality (~2 epochs).
ETH_MAX_DELAY_S=36
GC_MAX_DELAY_S=300

# A source event is only counted as missed once it is this old and still unsigned.
GRACE_S=1800

# ── Redis ────────────────────────────────────────────────────────────────────
# This value is for running the monitor directly on your machine. docker compose
# overrides it with the container hostname, so it is safe to leave as-is.
REDIS_URL=redis://127.0.0.1:6379

# ── Indexer ──────────────────────────────────────────────────────────────────
TICK_SECONDS=60
ETH_CONFIRMATIONS=12
GC_CONFIRMATIONS=12
ETH_CHUNK=5000
GC_CHUNK=10000

# Leave unset to start from the current head. Set to backfill from a block.
# ETH_START_BLOCK=
# GC_START_BLOCK=

# Per-event records are dropped after this; counters are permanent.
EVENT_TTL_S=2592000
SAMPLE_LIMIT=500

PORT=8080

# ── Bridge addresses (defaults are mainnet, override only for a fork) ────────
# ETH_AMB=0x4C36d2919e407f0Cc2Ee3c993ccF8ac26d9CE64e
# ETH_XDAI=0x4aa42145Aa6Ebf72e164C9bBC74fbD3788045016
# GC_AMB=0x75Df5AF045d91108662D8080fD1FEFAd6aA0bb59
# GC_XDAI=0x7301CFA0e1756B71869E93d4e4Dca5c7d0eb0AA6

# Used only for deploying/verifying contract K with Foundry.
# DEPLOYER_PRIVATE_KEY=
# GNOSISSCAN_API_KEY=
