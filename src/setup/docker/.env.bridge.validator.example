# Auto-generated by setup.js — do not edit manually

# EL JSON-RPC. Comma-separated for fallback providers; setup.js writes the
# single mock URL (http://host.docker.internal:8545/8546) under a mode profile.
GC_RPC=
ETH_RPC=

# Beacon RPC. Deliberately EMPTY: get_finalized_block_number() is beacon-first
# and only falls back to the EL `finalized` tag when no beacon URL is set —
# and the EL tag is what the mock owns. Setting these would take the finality
# pointer out of the test's control.
ETH_BC_RPC=
GC_BC_RPC=

DATABASE_URL=postgresql://bridge:bridge_password@postgres:5432/bridge_validator

# Block processing mode (fcr | block-finality). Set by setup.js.
ETH_BLOCK_PROCESSING_MODE=block-finality
GC_BLOCK_PROCESSING_MODE=block-finality

ETH_AMB_BRIDGE_ADDRESS=0x4C36d2919e407f0Cc2Ee3c993ccF8ac26d9CE64e
GC_AMB_BRIDGE_ADDRESS=0x75Df5AF045d91108662D8080fD1FEFAd6aA0bb59
ETH_XDAI_BRIDGE_ADDRESS=0x4aa42145Aa6Ebf72e164C9bBC74fbD3788045016
GC_XDAI_BRIDGE_ADDRESS=0x7301CFA0e1756B71869E93d4e4Dca5c7d0eb0AA6

# Bridge helper contracts (getSignatures) — used by the autoclaim path.
XDAI_BRIDGE_HELPER_ADDRESS=0xe30269bc61E677cD60aD163a221e464B7022fbf5
AMB_BRIDGE_HELPER_ADDRESS=0x7d94ece17e81355326e3359115D4B02411825EdD

POLL_INTERVAL_SECS=5
MAX_RETRY_COUNT=5

# How often the fcr checker revalidates safe-processed blocks that have since
# finalized (default in the validator: 30s). The harness advances finality on
# demand via evm_increaseBlocks, so the production cadence would be pure dead
# time between "test advanced finality" and "validator noticed" — the Layer B
# fcr timeouts (120s) are sized against this value.
FCR_CHECK_INTERVAL_SECS=10

AMB_VALIDATOR_PRIV_KEY=
XDAI_VALIDATOR_PRIV_KEY=

XDAI_EXECUTE_MESSAGE_ON_FOREIGN=false
AMB_EXECUTE_MESSAGE_ON_FOREIGN=false

RUST_LOG=info
